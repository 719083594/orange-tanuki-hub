# Optional settings for npm start. Existing environment variables take precedence.
HOST=127.0.0.1
PORT=7860
# Public HTTP(S) origin behind a reverse proxy; this is NOT authentication.
PUBLIC_ORIGIN=
# Read-only catalog JSON; relative paths resolve from the working directory.
CATALOG_PATH=

# Docker Compose only: host binding and host port, independent of HOST/PORT.
BIND_ADDRESS=127.0.0.1
HOST_PORT=7860
# Optional: host path used with compose.catalog.yaml.
# CATALOG_FILE=./runtime/catalog.json

# Optional private Hugging Face dataset (the actual token belongs in private environment only).
# VOICE_HF_TOKEN=           # do NOT commit actual values
# VOICE_DATASET_ID=        # optional primary voice corpus, e.g. namespace/repo
# VOICE_DATASET_REVISION=  # immutable 40-character commit SHA
# VOICE_DATASETS_JSON=     # optional JSON array of extra works; configured privately
# VOICE_CACHE_DIR=/tmp/orange-tanuki-voice
# VOICE_CACHE_MAX_BYTES=134217728
# VOICE_MAX_FILE_BYTES=67108864
