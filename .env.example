# Optional settings for npm start. Existing environment variables take precedence.
HOST=127.0.0.1
PORT=7860
# Public HTTP(S) origin behind a reverse proxy; this is NOT authentication.
PUBLIC_ORIGIN=
# Read-only catalog JSON; relative paths resolve from the working directory.
CATALOG_PATH=

# Docker Compose only: host binding and host port, independent of HOST/PORT.
BIND_ADDRESS=127.0.0.1
HOST_PORT=7860
# Optional: host path used with compose.catalog.yaml.
# CATALOG_FILE=./runtime/catalog.json
