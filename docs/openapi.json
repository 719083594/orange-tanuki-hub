            "required": false,
            "description": "每页数量。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ModelVersion"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          }
        }
      },
      "head": {
        "summary": "对应GET状态与响应头，不发送响应体。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码；超出结果范围返回空数组。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "每页数量。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "与GET相同状态；无响应体。"
          },
          "400": {
            "description": "与GET相同状态；无响应体。"
          },
          "404": {
            "description": "与GET相同状态；无响应体。"
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "summary": "上传尚未启用",
        "description": "固定503 storage_not_configured。不保存请求体，不写目录，不返回假成功。",
        "responses": {
          "503": {
            "description": "持久存储未配置。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "进程健康检查",
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "对应GET状态与响应头，不发送响应体。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "与GET相同状态；无响应体。"
          }
        }
      }
    },
    "/docs/openapi.json": {
      "get": {
        "summary": "读取本接口规范",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 JSON。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "对应GET状态与响应头，不发送响应体。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "与GET相同状态；无响应体。"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Hub": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "english_name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "english_name",
          "slug",
          "description"
        ]
      },
      "Storage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configured": {
            "const": false
          },
          "upload_enabled": {
            "const": false
          }
        },
        "required": [
          "configured",
          "upload_enabled"
        ],
        "description": "当前没有持久存储或上传实现。"
      },
      "Totals": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "works": {
            "type": "integer",
            "minimum": 0
          },
          "characters": {
            "type": "integer",
            "minimum": 0
          },
          "assets": {
            "type": "integer",
            "minimum": 0
          },
          "models": {
            "type": "integer",
            "minimum": 0
          },
          "model_versions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "works",
          "characters",
          "assets",
          "models",
          "model_versions"
        ]
      },
      "Info": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "english_name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "api_version": {
            "const": "v1"
          },
          "storage": {
            "$ref": "#/components/schemas/Storage"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          }
        },
        "required": [
          "name",
          "english_name",
          "slug",
          "description",
          "api_version",
          "storage",
          "totals"
        ]
      },
      "Stats": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "totals": {
            "$ref": "#/components/schemas/Totals"
          },
          "by_type": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "by_language": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "totals",
          "by_type",
          "by_language"
        ]
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "page",
          "page_size",
          "total",
          "total_pages"
        ]
      },
      "Work": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Character": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "work_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "work_id",
          "name"
        ]
      },
      "ResourceFile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "storage_key": {
            "type": "string",
            "minLength": 1,
            "description": "持久存储内的对象键；不是本机路径或下载URL。"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "download_url": {
            "type": "null",
            "description": "当前存储未配置，固定null；不生成假下载。"
          }
        },
        "required": [
          "storage_key",
          "media_type",
          "size_bytes",
          "sha256",
          "download_url"
        ]
      },
      "EmotionUnit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^u[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "sentence",
              "audio_event"
            ]
          },
          "char_start": {
            "type": "integer",
            "minimum": 0
          },
          "char_end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "emotions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intensity": {
            "type": [
              "string",
              "null"
            ]
          },
          "delivery": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "acoustic_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "annotation_source": {
            "enum": [
              "audio_model",
              "human",
              "unannotated"
            ]
          },
          "needs_confirmation": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "char_start",
          "char_end",
          "text",
          "emotions",
          "annotation_source",
          "needs_confirmation"
        ],
        "description": "char_start/end是Unicode码点区间[start,end)，不是JS UTF-16下标；按顺序完整覆盖原文。缺标签时emotions为空且needs_confirmation=true。模型标签不等于人审；辅助字段缺失保留null。"
      },
      "AudioTextBinding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "text_asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmotionUnit"
            }
          }
        },
        "required": [
          "source_id",
          "text",
          "units"
        ],
        "description": "一个音频与完整原文、逐句情绪绑定。text_asset_id可指向同源文本资源；以稳定source_id关联，不依赖文件名，保留完整字音。"
      },
      "Asset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "type": {
            "enum": [
              "audio",
              "image",
              "video",
              "text",
              "model"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "work_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "character_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "emotions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceFile"
              },
              {
                "type": "null"
              }
            ]
          },
          "audio_text": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AudioTextBinding"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_scope": {
            "type": "string",
            "enum": [
              "character",
              "standalone"
            ],
            "description": "每个image必填，其他资源禁止此字段。角色图片必须绑定有效角色及其所属作品；独立图片的work_id/character_id必须为null或省略。"
          }
        },
        "required": [
          "id",
          "type",
          "title"
        ],
        "description": "图片必须区分角色关联与独立图片：character要求有效角色和对应作品，standalone不绑定作品或角色。非图片禁止image_scope。audio_text仅适用于audio；原音文和逐句情绪绑定规则不变。",
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "image"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "image_scope"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "image_scope"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "image_scope": {
                  "const": "character"
                }
              },
              "required": [
                "image_scope"
              ]
            },
            "then": {
              "required": [
                "work_id",
                "character_id"
              ],
              "properties": {
                "work_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "character_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "image_scope": {
                  "const": "standalone"
                }
              },
              "required": [
                "image_scope"
              ]
            },
            "then": {
              "properties": {
                "work_id": {
                  "type": "null"
                },
                "character_id": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Model": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "work_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "character_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "模型下载目录，不代表提供在线声音生成；推理由调用方或外部服务执行。"
      },
      "ModelVersion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "framework": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ResourceFile"
            }
          }
        },
        "required": [
          "id",
          "model_id",
          "version",
          "framework",
          "dependencies",
          "files"
        ],
        "description": "同一model_id内version唯一。注明框架、依赖，每个文件记录大小和SHA-256，不混用版本。"
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "hub": {
            "$ref": "#/components/schemas/Hub"
          },
          "storage": {
            "$ref": "#/components/schemas/Storage"
          },
          "works": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Work"
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Character"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          },
          "model_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelVersion"
            }
          }
        },
        "required": [
          "schema_version",
          "hub",
          "storage",
          "works",
          "characters",
          "assets",
          "models",
          "model_versions"
        ],
        "description": "data/catalog.json是启动时读取的本地只读目录。当前五个集合全部为空，不提供写入口。各集合ID唯一，跨集合引用必须有效。"
      }
    },
    "responses": {
      "Error400": {
        "description": "无效参数、路径或不支持的方法。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "资源或入口不存在。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
